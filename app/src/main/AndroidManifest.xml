<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Slate"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Slate">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.config.WidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- All 2x2 Widgets point to @xml/widget_info_2x2 -->
        <receiver
            android:name=".widgets.battery.MinimalBatteryReceiver"
            android:exported="true"
            android:label="Slate Battery Tile">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_2x2" />
        </receiver>

        <receiver
            android:name=".widgets.battery.ArcGaugeBatteryReceiver"
            android:exported="true"
            android:label="Slate Arc Battery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_2x2" />
        </receiver>

        <!-- All 4x2 Widgets point to @xml/widget_info_4x2 -->
        <receiver
            android:name=".widgets.battery.MultiDeviceBatteryReceiver"
            android:exported="true"
            android:label="Slate Multi-Device Battery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_4x2" />
        </receiver>

        <!-- All 4x1 Widgets point to @xml/widget_info_4x1 -->
        <receiver
            android:name=".widgets.battery.HorizontalBatteryReceiver"
            android:exported="true"
            android:label="Slate Battery Strip">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_4x1" />
        </receiver>

    </application>

</manifest>