<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_productivity_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_canvas_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Top 3 Tasks Surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Target -->
        <FrameLayout
            android:id="@+id/btn_top3_open"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.28"
            android:clickable="true"
            android:focusable="true" />

        <!-- Task Item 1 -->
        <FrameLayout
            android:id="@+id/btn_top3_check_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.24"
            android:clickable="true"
            android:focusable="true" />

        <!-- Task Item 2 -->
        <FrameLayout
            android:id="@+id/btn_top3_check_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.24"
            android:clickable="true"
            android:focusable="true" />

        <!-- Task Item 3 -->
        <FrameLayout
            android:id="@+id/btn_top3_check_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.24"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</RelativeLayout>
