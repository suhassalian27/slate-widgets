<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_productivity_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_canvas_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <!-- Upper Tap Target (Opens Studio Settings) -->
    <FrameLayout
        android:id="@+id/btn_timer_open"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp"
        android:background="@android:color/transparent" />

    <!-- Full-Width Bottom Control Dock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:weightSum="100">

        <!-- -5m Touch Target (Left 26% of widget) -->
        <FrameLayout
            android:id="@+id/btn_timer_minus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="26"
            android:background="@android:color/transparent" />

        <!-- Center Toggle / Reset Target (Center 48% of widget) -->
        <FrameLayout
            android:id="@+id/btn_timer_toggle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="48"
            android:background="@android:color/transparent" />

        <!-- +5m Touch Target (Right 26% of widget) -->
        <FrameLayout
            android:id="@+id/btn_timer_plus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="26"
            android:background="@android:color/transparent" />
    </LinearLayout>
</FrameLayout>