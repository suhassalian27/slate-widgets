<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Canvas Surface -->
    <ImageView
        android:id="@+id/widget_canvas_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="Checklist Canvas Surface" />

    <!-- Synchronized Touch Overlay -->
    <LinearLayout
        android:id="@+id/layout_checklist_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: Title + Progress Count (1.25 weight) -->
        <FrameLayout
            android:id="@+id/btn_note_open_edit"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.25"
            android:clickable="true"
            android:focusable="true" />

        <!-- Row 0 -->
        <FrameLayout
            android:id="@+id/btn_check_item_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0"
            android:clickable="true"
            android:focusable="true" />

        <!-- Row 1 -->
        <FrameLayout
            android:id="@+id/btn_check_item_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0"
            android:clickable="true"
            android:focusable="true" />

        <!-- Row 2 -->
        <FrameLayout
            android:id="@+id/btn_check_item_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0"
            android:clickable="true"
            android:focusable="true" />

        <!-- Row 3 -->
        <FrameLayout
            android:id="@+id/btn_check_item_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0"
            android:clickable="true"
            android:focusable="true" />

        <!-- Row 4 -->
        <FrameLayout
            android:id="@+id/btn_check_item_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0"
            android:clickable="true"
            android:focusable="true" />

        <!-- Bottom Safe Inset: Prevents clipping against rounded corners (0.55 weight) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.55" />
    </LinearLayout>
</RelativeLayout>