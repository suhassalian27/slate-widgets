<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/checklist_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Surface: Renders the card plate -->
    <ImageView
        android:id="@+id/widget_canvas_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Card Background" />

    <!-- Content Container -->
    <LinearLayout
        android:id="@+id/layout_checklist_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Compact Header Band (42dp) -->
        <RelativeLayout
            android:id="@+id/btn_note_open_edit"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:id="@+id/txt_checklist_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/header_right_controls"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/header_right_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_checklist_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/icon_checklist_edit"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Edit Note" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Dynamic List Rows Container -->
        <LinearLayout
            android:id="@+id/layout_dynamic_checklist_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <!-- Bottom Inset Clearance (6dp) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="6dp" />

    </LinearLayout>
</RelativeLayout>