<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Transparent Canvas Surface (fitCenter maintains 1.65:1 tape geometry) -->
    <ImageView
        android:id="@+id/widget_canvas_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="Cassette Surface" />

    <!-- Synchronized Touch Targets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Upper 50%: Tape Sticker & Track Info (Tap to open player) -->
        <FrameLayout
            android:id="@+id/btn_media_open_app"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.50"
            android:clickable="true"
            android:focusable="true" />

        <!-- Lower 50%: Spools & Center Play Deck -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.50"
            android:orientation="horizontal">

            <!-- Left Spool: Previous Track -->
            <FrameLayout
                android:id="@+id/btn_media_prev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.0"
                android:clickable="true"
                android:focusable="true" />

            <!-- Center Disc: Play / Pause -->
            <FrameLayout
                android:id="@+id/btn_media_play_pause"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:clickable="true"
                android:focusable="true" />

            <!-- Right Spool: Next Track -->
            <FrameLayout
                android:id="@+id/btn_media_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.0"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>