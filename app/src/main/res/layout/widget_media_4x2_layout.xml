<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Canvas Surface for Background, Album Art & Visuals -->
    <ImageView
        android:id="@+id/widget_canvas_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Media Canvas Surface" />

    <!-- Synchronized Touch Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Left Column (48%): Full-Bleed Album Art -->
        <FrameLayout
            android:id="@+id/btn_media_open_app"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.48"
            android:clickable="true"
            android:focusable="true" />

        <!-- Right Column (52%): Metadata & Controls -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.52"
            android:orientation="vertical">

            <!-- Upper Area (46%): Metadata & Equalizer -->
            <FrameLayout
                android:id="@+id/btn_media_track_info"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.46"
                android:clickable="true"
                android:focusable="true" />

            <!-- Lower Area (54%): 3 Equal-Width Touch Slots (1:1:1) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.54"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btn_media_prev"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true" />

                <FrameLayout
                    android:id="@+id/btn_media_play_pause"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true" />

                <FrameLayout
                    android:id="@+id/btn_media_next"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>