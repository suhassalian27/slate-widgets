<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- Canvas Surface -->
    <ImageView
        android:id="@+id/widget_canvas_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Studio Calc Surface" />

    <!-- 4x2 Horizontal Split Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- LEFT COLUMN: 4x4 Numpad Grid (56% Width) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.56"
            android:orientation="vertical">

            <!-- Row 1: 7, 8, 9, ÷ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <FrameLayout android:id="@+id/btn_calc_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" />
                <FrameLayout android:id="@+id/btn_calc_8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" />
                <FrameLayout android:id="@+id/btn_calc_9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" />
                <FrameLayout android:id="@+id/btn_calc_div" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" />
            </LinearLayout>

            <!-- Row 2: 4, 5, 6, × -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <FrameLayout android:id="@+id/btn_calc_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" />
                <FrameLayout android:id="@+id/btn_calc_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" />
                <FrameLayout android:id="@+id/btn_calc_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" />
                <FrameLayout android:id="@+id/btn_calc_mul" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" />
            </LinearLayout>

            <!-- Row 3: 1, 2, 3, - -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <FrameLayout android:id="@+id/btn_calc_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" />
                <FrameLayout android:id="@+id/btn_calc_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" />
                <FrameLayout android:id="@+id/btn_calc_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" />
                <FrameLayout android:id="@+id/btn_calc_sub" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" />
            </LinearLayout>

            <!-- Row 4: 0, ., %, + -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <FrameLayout android:id="@+id/btn_calc_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" />
                <FrameLayout android:id="@+id/btn_calc_dot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" />
                <FrameLayout android:id="@+id/btn_calc_percent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" />
                <FrameLayout android:id="@+id/btn_calc_add" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- RIGHT COLUMN: Result Screen (75%) + AC & DEL Row (25%) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.44"
            android:orientation="vertical">

            <!-- Result Screen Area (Top 3 Rows: 75% Height) -->
            <FrameLayout
                android:id="@+id/btn_calc_display"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.75"
                android:clickable="true"
                android:focusable="true" />

            <!-- Utility Row: AC and DEL (Row 4: 25% Height) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.25"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btn_calc_ac"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true" />

                <FrameLayout
                    android:id="@+id/btn_calc_del"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>